{
 "doctype": "DocType",
 "name": "Quick Order Request",
 "module": "Kunal Enterprises",
 "autoname": "KE-QOR-.#####",
 "naming_rule": "Expression",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "request_details_section",
  "order_source",
  "confirmation_datetime",
  "request_details_column",
  "status",
  "customer_details_section",
  "customer",
  "customer_name",
  "customer_business_name",
  "customer_details_column",
  "customer_code",
  "customer_mobile_number",
  "customer_gstin",
  "sales_employee_details_section",
  "sales_employee",
  "sales_employee_name",
  "sales_employee_details_column",
  "sales_employee_code",
  "sales_employee_mobile_number",
  "order_request_section",
  "text",
  "text_display",
  "review_details_section",
  "review_started_at",
  "reviewed_by",
  "rejection_reason",
  "items",
  "order",
  "portal_reference_number"
 ],
 "fields": [
  {
   "fieldname": "request_details_section",
   "fieldtype": "Section Break",
   "label": "Request Details"
  },
  {
   "fieldname": "order_source",
   "fieldtype": "Select",
   "label": "Order Source",
   "options": "Customer\nSales Employee",
   "default": "Customer",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "confirmation_datetime",
   "fieldtype": "Datetime",
   "label": "Submitted On",
   "read_only": 1
  },
  {
   "fieldname": "request_details_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending Review\nIn Review\nConverted to Order\nRejected",
   "default": "Pending Review",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer_details_section",
   "fieldtype": "Section Break",
   "label": "Customer Details"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "label": "Customer Name",
   "fetch_from": "customer.customer_name",
   "read_only": 1
  },
  {
   "fieldname": "customer_business_name",
   "fieldtype": "Data",
   "label": "Business Name",
   "fetch_from": "customer.business_legal_name",
   "read_only": 1
  },
  {
   "fieldname": "customer_details_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "customer_code",
   "fieldtype": "Data",
   "label": "Party Code",
   "fetch_from": "customer.client_code",
   "read_only": 1
  },
  {
   "fieldname": "customer_mobile_number",
   "fieldtype": "Data",
   "label": "Customer Mobile Number",
   "fetch_from": "customer.mobile_number",
   "read_only": 1
  },
  {
   "fieldname": "customer_gstin",
   "fieldtype": "Data",
   "label": "GSTIN",
   "fetch_from": "customer.gstin",
   "read_only": 1
  },
  {
   "fieldname": "sales_employee_details_section",
   "fieldtype": "Section Break",
   "label": "Sales Employee Details",
   "depends_on": "eval:!!doc.sales_employee"
  },
  {
   "fieldname": "sales_employee",
   "fieldtype": "Link",
   "options": "Sales Employee",
   "label": "Sales Employee",
   "read_only": 1
  },
  {
   "fieldname": "sales_employee_name",
   "fieldtype": "Data",
   "label": "Sales Employee Name",
   "fetch_from": "sales_employee.sales_employee_name",
   "read_only": 1
  },
  {
   "fieldname": "sales_employee_details_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "sales_employee_code",
   "fieldtype": "Data",
   "label": "Employee Code",
   "fetch_from": "sales_employee.employee_code",
   "read_only": 1
  },
  {
   "fieldname": "sales_employee_mobile_number",
   "fieldtype": "Data",
   "label": "Sales Employee Mobile Number",
   "fetch_from": "sales_employee.mobile_number",
   "read_only": 1
  },
  {
   "fieldname": "order_request_section",
   "fieldtype": "Section Break",
   "label": "Order Request"
  },
  {
   "fieldname": "text",
   "fieldtype": "Code",
   "options": "Plain Text",
   "label": "Quick Order Text",
   "reqd": 1,
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "text_display",
   "fieldtype": "HTML",
   "label": "Quick Order Text"
  },
  {
   "fieldname": "review_details_section",
   "fieldtype": "Section Break",
   "label": "Review and Order"
  },
  {
   "fieldname": "review_started_at",
   "fieldtype": "Datetime",
   "label": "Review Started On",
   "read_only": 1
  },
  {
   "fieldname": "reviewed_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Reviewed By",
   "read_only": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Small Text",
   "label": "Rejection Reason",
   "read_only": 1
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "options": "Quick Order Request Item",
   "label": "Order Items"
  },
  {
   "fieldname": "order",
   "fieldtype": "Link",
   "options": "Order",
   "label": "Converted Order",
   "read_only": 1
  },
  {
   "fieldname": "portal_reference_number",
   "fieldtype": "Data",
   "label": "Order Reference",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "Owner",
   "read": 1,
   "select": 1,
   "write": 1
  },
  {
   "role": "Admin",
   "read": 1,
   "select": 1,
   "write": 1
  },
  {
   "role": "Order Coordinator",
   "read": 1,
   "select": 1,
   "write": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "actions": [],
 "links": [],
 "states": []
}
